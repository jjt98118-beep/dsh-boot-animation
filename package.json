{
  "name": "dsh-moss-boot",
  "version": "0.3.2",
  "description": "打开 DSH、打开新对话、或每次打开你钉住的那个会话时，铺满窗口播放一段片头动画。内置画面以《流浪地球》风格的太空站与量子智能体 MOSS（550W）为主题：红色独眼亮起，地球弧线从舷窗外掠过。四段片头直接内嵌在代码里（不带独立视频文件）；片库可以勾选任意几段随机轮换（不会连着两次同一段）、随时预览，也能换成你自己的视频。默认带声音，无需点击；设置旁一键钉住会话。 Full-frame intro animation for DSH themed on the Wandering Earth space station and MOSS, with a multi-clip random rotation.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "BSD-3-Clause",
  "author": "NativeDog1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjt98118-beep/dsh-moss-boot.git"
  },
  "homepage": "https://github.com/jjt98118-beep/dsh-moss-boot#readme",
  "bugs": {
    "url": "https://github.com/jjt98118-beep/dsh-moss-boot/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "boot-animation",
    "intro",
    "splash",
    "startup",
    "random",
    "rotation",
    "playlist"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:client": "node scripts/check-css-template.mjs && tsdown",
    "embed-clips": "node scripts/embed-clips.mjs",
    "check": "node scripts/check-css-template.mjs && node scripts/verify-routes.mjs",
    "verify:routes": "node scripts/verify-routes.mjs",
    "verify:letterbox": "node scripts/verify-letterbox.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    }
  },
  "contributors": [
    "jjt98118-beep (https://github.com/jjt98118-beep/dsh-moss-boot)"
  ]
}
